" some custom commands

" run groff+refer on file
command Man    :w|!sh -c 'p="%"; mandoc -T html -O man=\%N.\%S.html "$p" | awk "f;/<\/style>/{f=1}" | cat ~/.vim/templates/man.html - > "$p".html'
command TexCmp :silent !sh -c 'p="%"; pdflatex "$p"'
command Tex    :w|exe 'TexCmp'|redraw!
command BibCmp :silent !sh -c 'p="%"; biber "${p::-4}"'
command Bib    :w|exe 'TexCmp'|exe 'BibCmp'|exe 'TexCmp'|exe 'TexCmp'|redraw!
command Ty     :w|!typst compile --pdf-standard a-3b -- "%"

" abbreviations
iab SPDXcp: SPDX-FileCopyrightText:
iab SPDXid: SPDX-License-Identifier:
iab Cob: Co-authored-by:
iab <!dh> <!DOCTYPE html>
iab <metach> <meta charset=UTF-8>
iab <metavp> <meta name=viewport content="width=device-width, initial-scale=1">
iab <metacs> <meta name=color-scheme content="dark light">

" nice line numbers
set number
set relativenumber

command Nonum :set nonumber norelativenumber

syntax on
color pablo

set nocompatible

" vimrc sane defaults

filetype plugin indent on
set showcmd
set showmatch
set ignorecase
set smartcase
set incsearch
set autowrite
set hidden
set mouse=a
set backspace=indent,eol,start

" fmt stuffs
set textwidth=70
set formatoptions-=t
set nomodeline

au Filetype nix setlocal ts=2 sw=2 expandtab autoindent
au Filetype lisp setlocal expandtab

" jump to last position after opening
au BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g'\"" | endif
