#!/usr/bin/env python3

import sys, uuid, os
from lxml.html import fromstring, tostring


class Rewriter:
    def __init__(self, filename):
        self.dirname = os.path.abspath(os.path.dirname(filename))
        self.curdir = os.path.abspath(os.path.curdir)

    def rewrite(self, link):
        if link.startswith("//") or link.startswith("data:") or "://" in link:
            return link

        [link, *anchorstuff] = link.split("#")

        if len(link) != 0:
            link = (
                self.curdir + link
                if link.startswith("/")
                else self.dirname + "/" + link
            )
            if not (os.path.isfile(link) or link.endswith("/")):
                if os.path.exists(link + "/index.html"):
                    link = link + "/"
                elif os.path.exists(link + ".html"):
                    link = link + ".html"
                elif os.path.isdir(link):
                    link = link + "/"
            link = link.removeprefix(self.curdir)

        return "#".join([link] + anchorstuff)


for fn in sys.argv[1:]:
    with open(fn, "r") as f:
        try:
            html = fromstring(f.read())
        except:
            continue
    rewriter = Rewriter(fn)
    html.rewrite_links(rewriter.rewrite)

    with open(fn, "wb") as f:
        f.write(tostring(html, doctype="<!DOCTYPE html>"))
