#!/bin/sh

dat=$(openssl x509 -noout -enddate | cut -d= -f2)

if [ -z "$dat" ]
then
	exit 1
elif [ "$(uname)" = "OpenBSD" ]
then
	echo $(( ($(date -j -f "%b %d %T %Y %z" "$dat" "+%s") - $(date '+%s')) / 86400 ))
elif [ -x /bin/busybox ]
then
	echo $(( ($(busybox date -D "%b %d %T %Y %n" -ud "$dat" "+%s") - $(busybox date '+%s')) / 86400 ))
else
	echo $(( ($(date -ud "$dat" '+%s') - $(date '+%s')) / 86400 ))
fi
